# Local no-login TrueForge origin only. Never place secrets in VITE_* variables.
VITE_TRUEFORGE_URL=http://127.0.0.1:8790

# Non-secret model identifier configured in the local TrueForge installation.
# Example shape: provider/model-name. Leave blank until an actual local model is configured.
VITE_TRUEFORGE_MODEL=
